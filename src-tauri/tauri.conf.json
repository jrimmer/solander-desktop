{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solander",
  "version": "0.1.0",
  "identifier": "com.solander.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm prepare-dist",
    "beforeBuildCommand": "pnpm fetch-frontend && pnpm prepare-dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ipc: http://ipc.localhost https: wss:; img-src 'self' asset: http://asset.localhost https: blob: data:; style-src 'unsafe-inline' 'self'; media-src 'self' blob: mediastream:; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Solander",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Release.entitlements",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["solander"]
      }
    }
  }
}